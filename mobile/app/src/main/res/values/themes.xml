<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only removes the action bar and paints
         the launch window so there is no white flash before the first frame. -->
    <style name="Theme.Strive" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#050505</item>
        <item name="android:statusBarColor">#050505</item>
        <item name="android:navigationBarColor">#050505</item>
    </style>
</resources>
