    // 9 cases
    function rest() {
        return [
            { :name => "no strap at all leaves the base rest alone", :base => 150, :peakHr => null, :currentHr => null, :restingHr => 60, :ceiling => null, :expectSeconds => 150, :expectReady => false },
            { :name => "heart rate still high extends by fifteen seconds", :base => 150, :peakHr => 180, :currentHr => 150, :restingHr => 60, :ceiling => null, :expectSeconds => 165, :expectReady => false },
            { :name => "heart rate recovered early marks ready", :base => 150, :peakHr => 180, :currentHr => 100, :restingHr => 60, :ceiling => null, :expectSeconds => 150, :expectReady => true },
            { :name => "sitting exactly on target counts as ready", :base => 150, :peakHr => 180, :currentHr => 108, :restingHr => 60, :ceiling => null, :expectSeconds => 150, :expectReady => true },
            { :name => "the extension stops at one and a half times base", :base => 200, :peakHr => 190, :currentHr => 185, :restingHr => 60, :ceiling => 300, :expectSeconds => 215, :expectReady => false },
            { :name => "already at the ceiling stays there", :base => 295, :peakHr => 190, :currentHr => 185, :restingHr => 60, :ceiling => 300, :expectSeconds => 300, :expectReady => false },
            { :name => "a twenty second base is still thirty", :base => 20, :peakHr => null, :currentHr => null, :restingHr => 60, :ceiling => null, :expectSeconds => 30, :expectReady => false },
            { :name => "a hard effort on a short base cannot shrink it", :base => 20, :peakHr => 200, :currentHr => 190, :restingHr => 60, :ceiling => null, :expectSeconds => 30, :expectReady => false },
            { :name => "a profile with a low resting rate gets a lower target", :base => 120, :peakHr => 150, :currentHr => 95, :restingHr => 45, :ceiling => null, :expectSeconds => 135, :expectReady => false },
        ];
    }

    // 6 cases
    function seed() {
        return [
            { :name => "bench press seeds from twenty push-ups", :bodyKg => 80.0, :pushUpReps => 20, :squatReps => 25, :expectE1rm => { "pushup" => 86.666667, "squat" => 124.666667 }, :spec => { :id => "bench_press", :lo => 6, :hi => 10, :inc => 2.5, :minW => 20.0, :rest => 150, :pattern => "pushup", :bw => 0.0, :primary => { "pectoralis_major" => 1.0, "anterior_deltoid" => 0.55, "triceps_lateral" => 0.5 }, :secondary => { "pectoralis_minor" => 0.4, "serratus_anterior" => 0.3, "triceps_medial" => 0.3, "rotator_cuff" => 0.2 } }, :seeds => { "pushup" => 86.666667, "squat" => 124.666667 }, :expectWeight => 57.5 },
            { :name => "squat seeds from twenty-five bodyweight squats", :bodyKg => 80.0, :pushUpReps => 20, :squatReps => 25, :expectE1rm => { "pushup" => 86.666667, "squat" => 124.666667 }, :spec => { :id => "squats", :lo => 4, :hi => 8, :inc => 5.0, :minW => 20.0, :rest => 180, :pattern => "squat", :bw => 0.0, :primary => { "vastus_lateralis" => 0.9, "gluteus_maximus" => 0.9, "rectus_femoris" => 0.8, "vastus_medialis" => 0.8 }, :secondary => { "erector_spinae" => 0.5, "adductors" => 0.4, "biceps_femoris" => 0.4, "semitendinosus" => 0.3, "transverse_abdominis" => 0.3, "gluteus_medius" => 0.3 } }, :seeds => { "pushup" => 86.666667, "squat" => 124.666667 }, :expectWeight => 80.0 },
            { :name => "overhead press seeds from the same push-ups", :bodyKg => 80.0, :pushUpReps => 20, :squatReps => 25, :expectE1rm => { "pushup" => 86.666667, "squat" => 124.666667 }, :spec => { :id => "overhead_press", :lo => 6, :hi => 10, :inc => 2.5, :minW => 20.0, :rest => 120, :pattern => "pushup", :bw => 0.0, :primary => { "anterior_deltoid" => 1.0, "lateral_deltoid" => 0.6, "triceps_lateral" => 0.5 }, :secondary => { "trapezius_upper" => 0.4, "rotator_cuff" => 0.3, "serratus_anterior" => 0.3, "rectus_abdominis" => 0.2, "triceps_medial" => 0.2 } }, :seeds => { "pushup" => 86.666667, "squat" => 124.666667 }, :expectWeight => 57.5 },
            { :name => "an unmapped exercise starts on an empty bar", :bodyKg => 80.0, :pushUpReps => 20, :squatReps => 25, :expectE1rm => { "pushup" => 86.666667, "squat" => 124.666667 }, :spec => { :id => "cable_fly", :lo => 10, :hi => 15, :inc => 2.5, :minW => 2.5, :rest => 90, :pattern => "", :bw => 0.0, :primary => { "pectoralis_major" => 1.0 }, :secondary => { "anterior_deltoid" => 0.3 } }, :seeds => { "pushup" => 86.666667, "squat" => 124.666667 }, :expectWeight => 20.0 },
            { :name => "a pull-up has nothing to load", :bodyKg => 80.0, :pushUpReps => 20, :squatReps => 25, :expectE1rm => { "pushup" => 86.666667, "squat" => 124.666667 }, :spec => { :id => "pull_ups", :lo => 6, :hi => 10, :inc => 2.5, :minW => 0.0, :rest => 120, :pattern => "pullup", :bw => 1.0, :primary => { "latissimus_dorsi" => 1.0, "biceps_brachii" => 0.6, "teres_major" => 0.6 }, :secondary => { "rhomboids" => 0.4, "trapezius_mid" => 0.4, "brachialis" => 0.4, "forearm_flexors" => 0.4, "rectus_abdominis" => 0.2 } }, :seeds => { "pushup" => 86.666667, "squat" => 124.666667 }, :expectWeight => 0.0 },
            { :name => "a calibration of zero push-ups still seeds the bar", :bodyKg => 80.0, :pushUpReps => 0, :squatReps => 0, :expectE1rm => { "pushup" => 52.0, "squat" => 68.0 }, :spec => { :id => "bench_press", :lo => 6, :hi => 10, :inc => 2.5, :minW => 20.0, :rest => 150, :pattern => "pushup", :bw => 0.0, :primary => { "pectoralis_major" => 1.0, "anterior_deltoid" => 0.55, "triceps_lateral" => 0.5 }, :secondary => { "pectoralis_minor" => 0.4, "serratus_anterior" => 0.3, "triceps_medial" => 0.3, "rotator_cuff" => 0.2 } }, :seeds => { "pushup" => 52.0, "squat" => 68.0 }, :expectWeight => 35.0 },
        ];
    }
