            { :name => "fresh arms outrank a chest trained two days ago", :specs => [{ :id => "bench_press", :lo => 6, :hi => 10, :inc => 2.5, :minW => 20.0, :rest => 150, :pattern => "pushup", :bw => 0.0, :primary => { "pectoralis_major" => 1.0, "anterior_deltoid" => 0.55, "triceps_lateral" => 0.5 }, :secondary => { "pectoralis_minor" => 0.4, "serratus_anterior" => 0.3, "triceps_medial" => 0.3, "rotator_cuff" => 0.2 } }, { :id => "bicep_curls", :lo => 8, :hi => 12, :inc => 2.5, :minW => 2.5, :rest => 90, :pattern => "", :bw => 0.0, :primary => { "biceps_brachii" => 1.0, "brachialis" => 0.6 }, :secondary => { "brachioradialis" => 0.5, "forearm_flexors" => 0.4, "anterior_deltoid" => 0.1 } }], :sets => [{ :id => "bench_press", :weight => 100.0, :reps => 8, :rir => 1, :ts => 1555200 }, { :id => "bench_press", :weight => 100.0, :reps => 8, :rir => 1, :ts => 1555200 }, { :id => "bench_press", :weight => 100.0, :reps => 7, :rir => 1, :ts => 1555200 }], :now => 1728000, :expectOrder => ["bicep_curls", "bench_press"], :expectScores => { "bicep_curls" => 1.131046, "bench_press" => 0.987174 } },
            { :name => "identical lifts with no history tie on library order", :specs => [{ :id => "cable_fly", :lo => 10, :hi => 15, :inc => 2.5, :minW => 2.5, :rest => 90, :pattern => "", :bw => 0.0, :primary => { "pectoralis_major" => 1.0 }, :secondary => { "anterior_deltoid" => 0.3 } }, { :id => "bicep_curls", :lo => 8, :hi => 12, :inc => 2.5, :minW => 2.5, :rest => 90, :pattern => "", :bw => 0.0, :primary => { "biceps_brachii" => 1.0, "brachialis" => 0.6 }, :secondary => { "brachioradialis" => 0.5, "forearm_flexors" => 0.4, "anterior_deltoid" => 0.1 } }], :sets => [], :now => 1728000, :expectOrder => ["cable_fly", "bicep_curls"], :expectScores => { "cable_fly" => 1.15, "bicep_curls" => 1.15 } },
            { :name => "a lift that has not come up in nine days beats one trained yesterday", :specs => [{ :id => "bench_press", :lo => 6, :hi => 10, :inc => 2.5, :minW => 20.0, :rest => 150, :pattern => "pushup", :bw => 0.0, :primary => { "pectoralis_major" => 1.0, "anterior_deltoid" => 0.55, "triceps_lateral" => 0.5 }, :secondary => { "pectoralis_minor" => 0.4, "serratus_anterior" => 0.3, "triceps_medial" => 0.3, "rotator_cuff" => 0.2 } }, { :id => "bicep_curls", :lo => 8, :hi => 12, :inc => 2.5, :minW => 2.5, :rest => 90, :pattern => "", :bw => 0.0, :primary => { "biceps_brachii" => 1.0, "brachialis" => 0.6 }, :secondary => { "brachioradialis" => 0.5, "forearm_flexors" => 0.4, "anterior_deltoid" => 0.1 } }], :sets => [{ :id => "bench_press", :weight => 90.0, :reps => 8, :rir => 3, :ts => 950400 }, { :id => "bicep_curls", :weight => 15.0, :reps => 10, :rir => 3, :ts => 1641600 }], :now => 1728000, :expectOrder => ["bench_press", "bicep_curls"], :expectScores => { "bench_press" => 1.161959, "bicep_curls" => 1.00614 } },
            { :name => "a wrecked chest is excluded even with fresh triceps", :specs => [{ :id => "bench_press", :lo => 6, :hi => 10, :inc => 2.5, :minW => 20.0, :rest => 150, :pattern => "pushup", :bw => 0.0, :primary => { "pectoralis_major" => 1.0, "anterior_deltoid" => 0.55, "triceps_lateral" => 0.5 }, :secondary => { "pectoralis_minor" => 0.4, "serratus_anterior" => 0.3, "triceps_medial" => 0.3, "rotator_cuff" => 0.2 } }, { :id => "bicep_curls", :lo => 8, :hi => 12, :inc => 2.5, :minW => 2.5, :rest => 90, :pattern => "", :bw => 0.0, :primary => { "biceps_brachii" => 1.0, "brachialis" => 0.6 }, :secondary => { "brachioradialis" => 0.5, "forearm_flexors" => 0.4, "anterior_deltoid" => 0.1 } }], :sets => [{ :id => "bench_press", :weight => 100.0, :reps => 8, :rir => 1, :ts => 1728000 }, { :id => "bench_press", :weight => 100.0, :reps => 8, :rir => 1, :ts => 1728000 }, { :id => "bench_press", :weight => 100.0, :reps => 8, :rir => 1, :ts => 1728000 }, { :id => "bench_press", :weight => 100.0, :reps => 8, :rir => 1, :ts => 1728000 }, { :id => "bench_press", :weight => 100.0, :reps => 8, :rir => 1, :ts => 1728000 }, { :id => "bench_press", :weight => 100.0, :reps => 8, :rir => 1, :ts => 1728000 }, { :id => "bench_press", :weight => 100.0, :reps => 8, :rir => 1, :ts => 1728000 }, { :id => "bench_press", :weight => 100.0, :reps => 8, :rir => 1, :ts => 1728000 }], :now => 1728000, :expectOrder => ["bicep_curls"], :expectScores => { "bicep_curls" => 1.062 } },
            { :name => "eight training days earn the frequency term but not a staleness bonus", :specs => [{ :id => "bicep_curls", :lo => 8, :hi => 12, :inc => 2.5, :minW => 2.5, :rest => 90, :pattern => "", :bw => 0.0, :primary => { "biceps_brachii" => 1.0, "brachialis" => 0.6 }, :secondary => { "brachioradialis" => 0.5, "forearm_flexors" => 0.4, "anterior_deltoid" => 0.1 } }, { :id => "overhead_press", :lo => 6, :hi => 10, :inc => 2.5, :minW => 20.0, :rest => 120, :pattern => "pushup", :bw => 0.0, :primary => { "anterior_deltoid" => 1.0, "lateral_deltoid" => 0.6, "triceps_lateral" => 0.5 }, :secondary => { "trapezius_upper" => 0.4, "rotator_cuff" => 0.3, "serratus_anterior" => 0.3, "rectus_abdominis" => 0.2, "triceps_medial" => 0.2 } }], :sets => [{ :id => "bicep_curls", :weight => 15.0, :reps => 10, :rir => 3, :ts => 1641600 }, { :id => "bicep_curls", :weight => 15.0, :reps => 10, :rir => 3, :ts => 1382400 }, { :id => "bicep_curls", :weight => 15.0, :reps => 10, :rir => 3, :ts => 1036800 }, { :id => "bicep_curls", :weight => 15.0, :reps => 10, :rir => 3, :ts => 777600 }, { :id => "bicep_curls", :weight => 15.0, :reps => 10, :rir => 3, :ts => 432000 }, { :id => "bicep_curls", :weight => 15.0, :reps => 10, :rir => 3, :ts => 172800 }, { :id => "bicep_curls", :weight => 15.0, :reps => 10, :rir => 3, :ts => -172800 }, { :id => "bicep_curls", :weight => 15.0, :reps => 10, :rir => 3, :ts => -432000 }, { :id => "overhead_press", :weight => 45.0, :reps => 8, :rir => 3, :ts => 950400 }], :now => 1728000, :expectOrder => ["overhead_press", "bicep_curls"], :expectScores => { "overhead_press" => 1.16182, "bicep_curls" => 1.081545 } },
            { :name => "a lift trained today is not stale because it was also trained five days ago", :specs => [{ :id => "bench_press", :lo => 6, :hi => 10, :inc => 2.5, :minW => 20.0, :rest => 150, :pattern => "pushup", :bw => 0.0, :primary => { "pectoralis_major" => 1.0, "anterior_deltoid" => 0.55, "triceps_lateral" => 0.5 }, :secondary => { "pectoralis_minor" => 0.4, "serratus_anterior" => 0.3, "triceps_medial" => 0.3, "rotator_cuff" => 0.2 } }, { :id => "bicep_curls", :lo => 8, :hi => 12, :inc => 2.5, :minW => 2.5, :rest => 90, :pattern => "", :bw => 0.0, :primary => { "biceps_brachii" => 1.0, "brachialis" => 0.6 }, :secondary => { "brachioradialis" => 0.5, "forearm_flexors" => 0.4, "anterior_deltoid" => 0.1 } }], :sets => [{ :id => "bench_press", :weight => 100.0, :reps => 8, :rir => 4, :ts => 1728000 }, { :id => "bench_press", :weight => 100.0, :reps => 8, :rir => 4, :ts => 1296000 }, { :id => "bicep_curls", :weight => 15.0, :reps => 10, :rir => 4, :ts => 1296000 }], :now => 1728000, :expectOrder => ["bicep_curls", "bench_press"], :expectScores => { "bicep_curls" => 1.103143, "bench_press" => 0.991881 } },
            { :name => "a lift trained only today earns no staleness bonus", :specs => [{ :id => "bench_press", :lo => 6, :hi => 10, :inc => 2.5, :minW => 20.0, :rest => 150, :pattern => "pushup", :bw => 0.0, :primary => { "pectoralis_major" => 1.0, "anterior_deltoid" => 0.55, "triceps_lateral" => 0.5 }, :secondary => { "pectoralis_minor" => 0.4, "serratus_anterior" => 0.3, "triceps_medial" => 0.3, "rotator_cuff" => 0.2 } }, { :id => "bicep_curls", :lo => 8, :hi => 12, :inc => 2.5, :minW => 2.5, :rest => 90, :pattern => "", :bw => 0.0, :primary => { "biceps_brachii" => 1.0, "brachialis" => 0.6 }, :secondary => { "brachioradialis" => 0.5, "forearm_flexors" => 0.4, "anterior_deltoid" => 0.1 } }], :sets => [{ :id => "bicep_curls", :weight => 15.0, :reps => 10, :rir => 3, :ts => 1728000 }, { :id => "bicep_curls", :weight => 15.0, :reps => 10, :rir => 3, :ts => 1728000 }, { :id => "bench_press", :weight => 100.0, :reps => 8, :rir => 3, :ts => 1728000 }, { :id => "bench_press", :weight => 100.0, :reps => 8, :rir => 3, :ts => 1382400 }], :now => 1728000, :expectOrder => ["bench_press", "bicep_curls"], :expectScores => { "bench_press" => 0.979717, "bicep_curls" => 0.926976 } },
        ];
