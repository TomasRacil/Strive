<?xml version="1.0"?>
<!--
  Device list is deliberately short: monkeyc fails the build for a product id it
  does not know, so add the exact model once the SDK is installed. Run monkeyc
  with the "devices" flag to list valid ids, then add an iq:product entry below.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="1">
  <iq:application
    entry="StriveApp"
    id="C3D39C12C10DCB1EC9E4AEFFABF5A0B5"
    launcherIcon="@Drawables.LauncherIcon"
    minApiLevel="4.2.0"
    name="@Strings.AppName"
    type="watch-app">

    <iq:products>
      <iq:product id="fenix847mm"/>
    </iq:products>

    <!-- No Fit permission: this app never records a FIT activity, and declaring
         it is what gets an app filed alongside Gym and Running instead of with
         the other apps. -->
    <iq:permissions>
      <!-- Phone <-> watch messages for the companion app. -->
      <iq:uses-permission id="Communications"/>
      <!-- Direct BLE to the phone, bypassing Garmin Connect entirely. The watch
           is the central (client); the phone runs the GATT server. -->
      <iq:uses-permission id="BluetoothLowEnergy"/>
      <!-- Heart rate for rest timing: the compiler refuses Toybox.Sensor without
           it, and the rest clock reads the strap while the set is being done. -->
      <iq:uses-permission id="Sensor"/>
    </iq:permissions>

    <iq:languages>
      <iq:language>eng</iq:language>
    </iq:languages>
  </iq:application>
</iq:manifest>
